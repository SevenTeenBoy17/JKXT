# JKXT V2.0 public single-host delivery template.
# Copy to .env.public on the production host. Never commit real secrets.

DEPLOY_MODE=private
SPRING_PROFILES_ACTIVE=private
JKXT_DEPLOY_MODE=private
JKXT_FIXED_ORG_ID=00000000-0000-0000-0000-000000000001
FIXED_ORG_ID=00000000-0000-0000-0000-000000000001

# Public DNS name that points to the host running docker-compose.public.yml.
PUBLIC_DOMAIN=app.example.jkxt.cn
PUBLIC_APP_URL=https://app.example.jkxt.cn

POSTGRES_DB=jkxt_public
POSTGRES_USER=jkxt
POSTGRES_PASSWORD=replace_with_secret_manager_value

API_PUBLIC_BASE=/api/v1
APP_BASE_URL=https://app.example.jkxt.cn
CORS_ALLOWED_ORIGINS=https://app.example.jkxt.cn

# Production go-live values.
JKXT_DISABLE_DEMO_ACCOUNTS=true
JKXT_DISABLE_DEMO_ROSTER=true
JKXT_STRICT_PRODUCTION_CHECKS=true
JKXT_AUTH_CAPTCHA_DEBUG=false
JKXT_AUTH_COOKIE_SECURE=true
JKXT_AUTH_COOKIE_SAME_SITE=Lax

# 可信反向代理网段：本栈是 caddy → nginx → app，三者都在 docker bridge 网段内，只有该网段的直连对端写的
# X-Forwarded-For 才被采信，公网客户端的真实 IP 由此仍能准确记入登录审计；伪造的 XFF 前缀则被忽略。
# 若本机 docker 网络不在默认地址池(172.16.0.0/12)，改成实际子网。
JKXT_AUTH_TRUSTED_PROXIES=172.16.0.0/12

# Leave disabled unless an approved server-side OpenAI-compatible provider is configured.
# Inject JKXT_LLM_API_KEY from the production secret manager; never save a real key in this file.
# Set ACCEPTANCE_MODE=true during real UAT so mock/disabled/upstream fallback cannot return HTTP 200.
JKXT_LLM_ENABLED=false
JKXT_LLM_ACCEPTANCE_MODE=false
JKXT_LLM_PROVIDER=gpt-agent
JKXT_LLM_BASE_URL=https://api.llm-token.cn/v1
JKXT_LLM_FALLBACK_BASE_URL=https://gpt-agent.cc/v1
JKXT_LLM_API_KEY=
JKXT_LLM_MODEL=claude-sonnet-4-6
JKXT_LLM_MAX_RETRIES=2
JKXT_LLM_MONTHLY_QUOTA=1000

JKXT_EXTERNAL_SMS_ENABLED=false
JKXT_VERSION=0.12.0-p12-public
