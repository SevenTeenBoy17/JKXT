# JKXT V2.0 local development environment example.
# Copy to .env for local development. Do not commit real secrets.

DEPLOY_MODE=dev
JKXT_DEPLOY_MODE=dev
JKXT_FIXED_ORG_ID=00000000-0000-0000-0000-000000000001
JKXT_EXTERNAL_SMS_ENABLED=false
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
API_PUBLIC_BASE=/api/v1
APP_BASE_URL=http://127.0.0.1:8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jkxt
POSTGRES_USER=jkxt
POSTGRES_PASSWORD=jkxt_dev_password
DATABASE_URL=jdbc:postgresql://localhost:5432/jkxt
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jkxt
SPRING_DATASOURCE_USERNAME=jkxt
SPRING_DATASOURCE_PASSWORD=jkxt_dev_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

AUTH_SESSION_COOKIE=JKXT_SESSION
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_ACCESS_TTL_MINUTES=60
AUTH_REFRESH_TTL_DAYS=7
JWT_ISSUER=jkxt-local
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:4174,http://localhost:4174

SCHEDULER_PROGRESS_TRANSPORT=stomp
SCHEDULER_RUN_TIMEOUT_SECONDS=60
ORTOOLS_TIME_LIMIT_SECONDS=45

JKXT_LLM_ENABLED=false
JKXT_LLM_ACCEPTANCE_MODE=false
JKXT_LLM_PROVIDER=gpt-agent
JKXT_LLM_BASE_URL=https://api.llm-token.cn/v1
JKXT_LLM_FALLBACK_BASE_URL=https://gpt-agent.cc/v1
JKXT_LLM_API_KEY=
JKXT_LLM_MODEL=claude-sonnet-4-6
JKXT_LLM_TIMEOUT_MS=12000
JKXT_LLM_MAX_RETRIES=2

FIXED_ORG_ID=
LOG_LEVEL=INFO
