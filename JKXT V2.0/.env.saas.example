# JKXT V2.0 SaaS multi-tenant delivery template.
# Copy to .env.saas in your deployment environment. Never commit real secrets.

DEPLOY_MODE=saas
SPRING_PROFILES_ACTIVE=saas
JKXT_DEPLOY_MODE=saas

SERVER_PORT=8080
API_PUBLIC_BASE=/api/v1
APP_BASE_URL=https://app.example.jkxt.cn
CORS_ALLOWED_ORIGINS=https://app.example.jkxt.cn

POSTGRES_HOST=postgres.example.internal
POSTGRES_PORT=5432
POSTGRES_DB=jkxt_saas
POSTGRES_USER=jkxt
POSTGRES_PASSWORD=replace_with_secret_manager_value
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.example.internal:5432/jkxt_saas
SPRING_DATASOURCE_USERNAME=jkxt
SPRING_DATASOURCE_PASSWORD=replace_with_secret_manager_value

REDIS_HOST=redis.example.internal
REDIS_PORT=6379
SPRING_DATA_REDIS_HOST=redis.example.internal
SPRING_DATA_REDIS_PORT=6379

JKXT_AUTH_CAPTCHA_DEBUG=false
JKXT_AUTH_COOKIE_SECURE=true
JKXT_AUTH_COOKIE_SAME_SITE=Lax

# 可信反向代理网段(逗号分隔 IP/CIDR)。留空 = 不信任 X-Forwarded-For，客户端 IP 一律取直连对端。
# 云上 app 前若有 LB/ingress，必须填其实际网段，否则登录审计 IP 会记成 LB 的地址；
# 切勿图省事填 0.0.0.0/0 —— 那等于恢复"任何人都能伪造审计 IP"的旧行为。
# JKXT_AUTH_TRUSTED_PROXIES=10.0.0.0/16

# SaaS deployments may enable provider-backed LLM after quota/cost controls are ready.
JKXT_LLM_ENABLED=false
JKXT_LLM_ACCEPTANCE_MODE=false
JKXT_LLM_PROVIDER=gpt-agent
JKXT_LLM_BASE_URL=https://api.llm-token.cn/v1
JKXT_LLM_FALLBACK_BASE_URL=https://gpt-agent.cc/v1
JKXT_LLM_API_KEY=
JKXT_LLM_MODEL=claude-sonnet-4-6
JKXT_LLM_MAX_RETRIES=2
JKXT_LLM_MONTHLY_QUOTA=1000

# External SMS/email gateways are enabled by environment-specific adapters.
JKXT_EXTERNAL_SMS_ENABLED=true

JKXT_VERSION=0.12.0-p12-saas
