# JKXT V2.0 private single-school delivery template.
# Copy to .env.private and change every password/secret before production.

DEPLOY_MODE=private
SPRING_PROFILES_ACTIVE=private
JKXT_DEPLOY_MODE=private
JKXT_FIXED_ORG_ID=00000000-0000-0000-0000-000000000001
FIXED_ORG_ID=00000000-0000-0000-0000-000000000001

PRIVATE_HTTP_PORT=18180
PRIVATE_BACKEND_PORT=18081
PRIVATE_POSTGRES_PORT=15432
PRIVATE_REDIS_PORT=16379

POSTGRES_DB=jkxt_private
POSTGRES_USER=jkxt
POSTGRES_PASSWORD=change_me_private_password

REDIS_HOST=redis
REDIS_PORT=6379

API_PUBLIC_BASE=/api/v1
APP_BASE_URL=http://127.0.0.1:18180
CORS_ALLOWED_ORIGINS=http://127.0.0.1:18180,http://localhost:18180

# UAT keeps captcha debug enabled so the smoke script can log in.
# Set JKXT_AUTH_CAPTCHA_DEBUG=false before production go-live.
JKXT_AUTH_CAPTCHA_DEBUG=true
JKXT_AUTH_COOKIE_SECURE=false
JKXT_AUTH_COOKIE_SAME_SITE=Lax

# 可信反向代理网段：只有落在这里的直连对端(本栈即 nginx 容器)写的 X-Forwarded-For 才会被当作客户端 IP
# 记入登录审计，其它来源的该头一律忽略(否则任何人都能伪造审计 IP)。
# 默认 172.16.0.0/12 覆盖 docker 默认地址池；若本机 docker 网络不在该段，改成 nginx 容器的实际子网。
# 留空 = 完全不信任 X-Forwarded-For，审计 IP 会记成 nginx 的容器 IP。
JKXT_AUTH_TRUSTED_PROXIES=172.16.0.0/12

# OpenAI-compatible server-side endpoint. The low-latency domestic default is shown below.
# Alternative approved base: https://gpt-agent.cc/v1 (a full /v1/chat/completions URL is also valid).
# Keep the key outside this file; inject it from the deployment environment/secret manager.
# For a real UAT evidence run set ENABLED=true and ACCEPTANCE_MODE=true; solver-only operation may
# leave both false and will label the deterministic policy draft as fallback.
JKXT_LLM_ENABLED=false
JKXT_LLM_ACCEPTANCE_MODE=false
JKXT_LLM_PROVIDER=gpt-agent
JKXT_LLM_BASE_URL=https://api.llm-token.cn/v1
JKXT_LLM_FALLBACK_BASE_URL=https://gpt-agent.cc/v1
JKXT_LLM_API_KEY=
JKXT_LLM_MODEL=claude-sonnet-4-6
JKXT_LLM_MAX_RETRIES=2

# External SMS is disabled in private mode by default.
JKXT_EXTERNAL_SMS_ENABLED=false

JKXT_VERSION=0.12.0-p12-private
